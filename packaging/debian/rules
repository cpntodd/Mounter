#!/usr/bin/make -f
# Debian packaging rules for Mounter
# Uses the standard debhelper + meson build flow.

export DH_VERBOSE = 1

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		-Dlibexecdir=/usr/libexec

# Ensure the helper is installed with correct permissions
override_dh_fixperms:
	dh_fixperms
	# mounter-helper needs to be executable by pkexec (polkit)
	chmod 755 debian/mounter/usr/libexec/mounter/mounter-helper

# Strip binaries (handled automatically by dh_strip)
override_dh_strip:
	dh_strip --dbgsym-migration='mounter-dbg (<< 0.1.0~)'
